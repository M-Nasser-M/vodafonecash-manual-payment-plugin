{
  "name": "@m-nasser-m/medusa-payment-vodafone-cash-manual",
  "version": "0.0.20",
  "description": "Vodafone Cash manual payment provider for Medusa - Requires manual verification of payments",
  "author": "Mohamed Nasser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/M-Nasser-M/vodafonecash-manual-payment-plugin.git"
  },
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "homepage": "https://github.com/M-Nasser-M/vodafonecash-manual-payment-plugin#readme",
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-payment",
    "medusa-payment",
    "medusa-payment-vodafone-cash-manual",
    "payment",
    "plugin"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "bun run predev && medusa plugin:develop",
    "predev": "medusa plugin:publish",
    "lint": "medusa lint",
    "prepublishOnly": "medusa plugin:build",
    "bunpublish": "bun publish"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "^2.15.2",
    "@medusajs/cli": "^2.15.2",
    "@medusajs/eslint-plugin": "^2.15.2",
    "@medusajs/framework": "^2.15.2",
    "@medusajs/icons": "^2.15.2",
    "@medusajs/medusa": "^2.15.2",
    "@medusajs/test-utils": "^2.15.2",
    "@medusajs/ui": "4.2.0",
    "@swc/core": "1.5.7",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.0.0",
    "jiti": "^2.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.15.2",
    "@medusajs/cli": "^2.15.2",
    "@medusajs/framework": "^2.15.2",
    "@medusajs/icons": "^2.15.2",
    "@medusajs/medusa": "^2.15.2",
    "@medusajs/test-utils": "^2.15.2",
    "@medusajs/ui": "4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "trustedDependencies": [
    "@medusajs/telemetry",
    "@swc/core"
  ]
}